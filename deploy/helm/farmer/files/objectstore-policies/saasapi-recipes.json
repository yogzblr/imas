{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LocateBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::RECIPE_BUCKET"]
    },
    {
      "Sid": "ListTenantRecipesOnly",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::RECIPE_BUCKET"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["tenants/*/recipes/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteTenantRecipes",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::RECIPE_BUCKET/tenants/*/recipes/*"]
    },
    {
      "Sid": "AppendRecipeAuditOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::RECIPE_BUCKET/tenants/*/recipe-audit/*"]
    }
  ]
}
