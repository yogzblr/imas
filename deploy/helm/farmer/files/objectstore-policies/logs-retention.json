{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLogBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::LOG_BUCKET"]
    },
    {
      "Sid": "DeleteLogsOnly",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::LOG_BUCKET/LOG_PREFIX*"]
    }
  ]
}
