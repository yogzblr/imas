post_install() {
    echo "Creating farmer user and group..."
    if ! getent group farmer >/dev/null 2>&1; then
        groupadd -r farmer
    fi
    if ! getent passwd farmer >/dev/null 2>&1; then
        useradd -r -g farmer -d /var/cache/imas/farmer -s /bin/false farmer
    fi
    
    # Set ownership
    chown -R farmer:farmer /etc/imas/pki/farmer /var/cache/imas/farmer 2>/dev/null || true
    
    echo "Reloading systemd daemon..."
    systemctl daemon-reload
    
    echo "imas-farmer installed. To start the service:"
    echo "  sudo systemctl enable imas-farmer.service"
    echo "  sudo systemctl start imas-farmer.service"
    echo ""
    echo "Don't forget to configure /etc/imas/farmer before starting!"
}

post_upgrade() {
    post_install
}

pre_remove() {
    if systemctl is-active imas-farmer.service >/dev/null 2>&1; then
        echo "Stopping imas-farmer service..."
        systemctl stop imas-farmer.service
    fi
    if systemctl is-enabled imas-farmer.service >/dev/null 2>&1; then
        echo "Disabling imas-farmer service..."
        systemctl disable imas-farmer.service
    fi
} 