[Unit]
Description=imas Sprout - Remote Control Agent
Documentation=https://imas.dev
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/imas-sprout
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Security settings
NoNewPrivileges=false
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Working directory and environment
WorkingDirectory=/var/cache/imas/sprout
Environment=IMAS_CONFIG=/etc/imas/sprout

[Install]
WantedBy=multi-user.target 