#!/usr/bin/env bash
# Stub az for uat/scripts/tests/scripts_test.sh. Logs its arguments to
# $STUB_STATE/calls.log; its answers come from files in $STUB_STATE.
set -u
echo "az $*" >>"$STUB_STATE/calls.log"

# arg NAME: the value after --NAME in the arguments.
arg() {
  local want=$1 prev=""
  for a in "${ARGS[@]}"; do
    [ "$prev" = "--$want" ] && { printf '%s' "$a"; return 0; }
    prev=$a
  done
  return 1
}
ARGS=("$@")

case "$1 $2" in
  "group list")
    tag=$(arg tag)
    case "$tag" in
      purpose=imas-uat)
        [ -f "$STUB_STATE/list_fail" ] && { echo "ERROR: stub list failure" >&2; exit 1; }
        if [ -f "$STUB_STATE/listing.json" ]; then cat "$STUB_STATE/listing.json"; else cat "$STUB_STATE/groups.json"; fi
        ;;
      run_id=*)
        [ -f "$STUB_STATE/group_list_fail" ] && { echo "ERROR: stub failure" >&2; exit 1; }
        cat "$STUB_STATE/tagged_groups" 2>/dev/null || true
        ;;
      *) echo "stub az: unexpected tag filter $tag" >&2; exit 99 ;;
    esac
    ;;
  "group show")
    name=$(arg name)
    if [ -f "$STUB_STATE/show/$name" ]; then cat "$STUB_STATE/show/$name"; exit 0; fi
    jq -e --arg n "$name" '.[] | select(.name == $n)' "$STUB_STATE/groups.json" 2>/dev/null || {
      echo "ERROR: (ResourceGroupNotFound) $name" >&2
      exit 3
    }
    ;;
  "group delete")
    name=$(arg name)
    [ -f "$STUB_STATE/delete_fail/$name" ] && { echo "ERROR: stub delete failure" >&2; exit 1; }
    jq --arg n "$name" 'map(select(.name != $n))' "$STUB_STATE/groups.json" >"$STUB_STATE/groups.json.new" &&
      mv "$STUB_STATE/groups.json.new" "$STUB_STATE/groups.json"
    ;;
  "group exists")
    # One answer per line in group_exists; the last one repeats.
    n=$(cat "$STUB_STATE/exists_calls" 2>/dev/null || echo 0)
    echo $((n + 1)) >"$STUB_STATE/exists_calls"
    v=$(sed -n "$((n + 1))p" "$STUB_STATE/group_exists" 2>/dev/null)
    [ -n "$v" ] || v=$(tail -n 1 "$STUB_STATE/group_exists" 2>/dev/null)
    [ -n "$v" ] || v=false
    [ "$v" = error ] && { echo "ERROR: stub failure" >&2; exit 1; }
    echo "$v"
    ;;
  "resource list")
    [ -f "$STUB_STATE/resource_list_fail" ] && { echo "ERROR: stub failure" >&2; exit 1; }
    cat "$STUB_STATE/leftovers" 2>/dev/null || true
    ;;
  "account show")
    # Login state: with not_logged_in present, the CLI is logged out until
    # az login has run. The answers are plain values, as with -o tsv.
    if [ -f "$STUB_STATE/not_logged_in" ] && [ ! -f "$STUB_STATE/logged_in" ]; then
      echo "ERROR: Please run 'az login' to setup account." >&2
      exit 1
    fi
    case "$(arg query)" in
      "") echo '{"id": "stub"}' ;;
      id) cat "$STUB_STATE/subscription" 2>/dev/null || echo 11111111-1111-1111-1111-111111111111 ;;
      name) echo "UAT subscription" ;;
      tenantId) echo 22222222-2222-2222-2222-222222222222 ;;
      *) echo "stub az: unexpected account query" >&2; exit 99 ;;
    esac
    ;;
  "account set") arg subscription >"$STUB_STATE/subscription" ;;
  "login "*) touch "$STUB_STATE/logged_in" ;;
  "provider register") ;;
  "ad app")
    case "$3" in
      list) cat "$STUB_STATE/app_ids" 2>/dev/null || true ;;
      create)
        echo 33333333-3333-3333-3333-333333333333 >"$STUB_STATE/app_ids"
        echo 33333333-3333-3333-3333-333333333333
        ;;
      federated-credential)
        case "$4" in
          list) cat "$STUB_STATE/fed_subjects" 2>/dev/null || true ;;
          create)
            [ -f "$STUB_STATE/fed_fail" ] && { echo "ERROR: stub failure" >&2; exit 1; }
            arg parameters | jq -r .subject >>"$STUB_STATE/fed_subjects"
            ;;
          *) echo "stub az: unexpected call: $*" >&2; exit 99 ;;
        esac
        ;;
      *) echo "stub az: unexpected call: $*" >&2; exit 99 ;;
    esac
    ;;
  "ad sp")
    case "$3" in
      show)
        [ -f "$STUB_STATE/sp_exists" ] || { echo "ERROR: service principal not found" >&2; exit 1; }
        echo 44444444-4444-4444-4444-444444444444
        ;;
      create) touch "$STUB_STATE/sp_exists" ;;
      *) echo "stub az: unexpected call: $*" >&2; exit 99 ;;
    esac
    ;;
  "role assignment")
    case "$3" in
      list) if [ -f "$STUB_STATE/role_assigned" ]; then echo 1; else echo 0; fi ;;
      create)
        # role_fail_times: the first N creates fail, as a new service
        # principal does while it is not visible yet.
        n=$(cat "$STUB_STATE/role_fail_times" 2>/dev/null || echo 0)
        if [ "$n" -gt 0 ]; then
          echo $((n - 1)) >"$STUB_STATE/role_fail_times"
          echo "ERROR: PrincipalNotFound" >&2
          exit 1
        fi
        touch "$STUB_STATE/role_assigned"
        ;;
      *) echo "stub az: unexpected call: $*" >&2; exit 99 ;;
    esac
    ;;
  "vm image") ;;
  *)
    echo "stub az: unexpected call: $*" >&2
    exit 99
    ;;
esac
