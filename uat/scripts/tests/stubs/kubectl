#!/usr/bin/env bash
# Stub kubectl for uat/scripts/tests/scripts_test.sh (diagnostics.sh). Logs
# its arguments; answers like a hub with a RustFS pod, a failed Job's pod, a
# restarting pod, a healthy one and a healthy Keycloak pod. The failed Job's pod is Running and
# ready, so only the failed Job selects it. kubectl_fail in $STUB_STATE: every call
# fails.
set -u
echo "kubectl $*" >>"$STUB_STATE/calls.log"
[ -f "$STUB_STATE/kubectl_fail" ] && { echo "Unable to connect to the server: stub" >&2; exit 1; }
args=" $* "
pod() { # pod NS NAME PHASE READY RESTARTS [JOB]
  jq -n --arg ns "$1" --arg n "$2" --arg ph "$3" --argjson r "$4" --argjson rc "$5" --arg job "${6:-}" \
    '{metadata: {namespace: $ns, name: $n, labels: (if $job == "" then {} else {"job-name": $job} end)},
      status: {phase: $ph, containerStatuses: [{ready: $r, restartCount: $rc}]}}'
}
case "$args" in
  *" get pods -A -o json "*)
    { pod imas-uat imas-uat-rustfs-0 Running true 0
      pod imas-uat imas-uat-log-retention-1-abcde Running true 0 imas-uat-log-retention-1
      pod imas-uat imas-uat-farmer-7d9 Running false 4
      pod imas-uat imas-uat-saasapi-5c8 Running true 0
      pod imas-uat imas-uat-keycloak-6f4 Running true 0
      pod imas-uat imas-uat-done-1-xyz Succeeded false 0 imas-uat-done-1; } | jq -s '{items: .}'
    ;;
  *" get jobs -A -o json "*)
    jq -n '{items: [{metadata: {namespace: "imas-uat", name: "imas-uat-log-retention-1"}, status: {failed: 3}},
                    {metadata: {namespace: "imas-uat", name: "imas-uat-done-1"}, status: {succeeded: 1, completionTime: "2026-10-22T03:20:00Z"}}]}'
    ;;
  *" get endpoints -A -o json "*)
    jq -n '{items: [{metadata: {namespace: "imas-uat", name: "imas-uat-rustfs"}, subsets: []}]}'
    ;;
  *" describe pod "*)
    printf 'Name: %s\nEnvironment:\n  RUSTFS_SECRET_KEY:  stub-value-1\n  DB_PASSWORD=stub-value-2\n  AUTH: Bearer %s\n' \
      "${*: -1}" "eyJstubstubstub.eyJstubstubstub.sig"
    ;;
  *" logs "*"--previous"*)
    echo "Error from server (BadRequest): previous terminated container not found" >&2
    exit 1
    ;;
  *" logs -n imas-uat imas-uat-keycloak-6f4 "*)
    echo "2026-10-22T03:12:58Z INFO  [io.quarkus] Keycloak 26.4.0 started"
    echo "2026-10-22T03:12:59Z DEBUG [org.keycloak.services.managers.DefaultBruteForceProtector] quick login, set min wait seconds"
    echo "2026-10-22T03:13:00Z WARN  [org.keycloak.events] type=\"LOGIN_ERROR\", realmId=\"r\", clientId=\"imas-uat-tests\", userId=\"u\", error=\"user_temporarily_disabled\", password=stub-value-6"
    ;;
  *" logs "*)
    echo "2026-10-22T03:13:00Z dial tcp 10.99.61.204:9000: connect: connection refused"
    echo "2026-10-22T03:13:01Z GET /v1/x Authorization: Bearer opaqueStubValue4 404"
    echo "2026-10-22T03:13:02Z GET /v1/y Authorization: Basic c3R1YlVzZXI6c3R1YlZhbHVlNQ== 401"
    echo "2026-10-22T03:13:03Z GET /v1/z Authorization: Basic dTpw 401"
    ;;
  *" get svc,endpoints -A -o wide "*)
    printf 'NAMESPACE NAME ENDPOINTS\nimas-uat endpoints/imas-uat-rustfs <none>\n'
    ;;
  *)
    echo "NAME STATUS (stub: $*)"
    ;;
esac
