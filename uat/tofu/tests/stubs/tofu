#!/usr/bin/env bash
# Stub tofu for destroy_test.sh. Logs its arguments; behaviour comes from
# files in $STUB_STATE.
set -u
# log_line <text>: appends one line to calls.log in a single write, under an
# flock when available. Stubs run concurrently (tunnels.sh starts every tunnel
# at once), and a line written in pieces can be glued to another stub's.
log_line() {
  if command -v flock >/dev/null 2>&1; then
    { flock 9; printf '%s\n' "$1" >&9; } 9>>"$STUB_STATE/calls.log"
  else
    printf '%s\n' "$1" >>"$STUB_STATE/calls.log"
  fi
}
log_line "tofu $*"
for a in "$@"; do
  case "$a" in
    init)
      exit "$(cat "$STUB_STATE/init_rc" 2>/dev/null || echo 0)"
      ;;
    destroy)
      rc=$(cat "$STUB_STATE/destroy_rc" 2>/dev/null || echo 0)
      if [ "$rc" -eq 0 ] && [ -f "$STUB_STATE/destroy_clears" ]; then
        echo false >"$STUB_STATE/group_exists"
        : >"$STUB_STATE/leftovers"
      fi
      exit "$rc"
      ;;
  esac
done
exit 0
