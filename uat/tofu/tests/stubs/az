#!/usr/bin/env bash
# Stub az for destroy_test.sh. Logs its arguments; behaviour comes from files
# in $STUB_STATE.
set -u
# log_line <text>: appends one line to calls.log in a single write, under an
# flock when available. Stubs run concurrently (tunnels.sh starts every tunnel
# at once), and a line written in pieces can be glued to another stub's.
log_line() {
  if command -v flock >/dev/null 2>&1; then
    { flock 9; printf '%s\n' "$1" >&9; } 9>>"$STUB_STATE/calls.log"
  else
    printf '%s\n' "$1" >>"$STUB_STATE/calls.log"
  fi
}
log_line "az $*"
case "$1 $2" in
  "storage account")
    cat "$STUB_STATE/account" 2>/dev/null
    exit 0
    ;;
  "group exists")
    v=$(cat "$STUB_STATE/group_exists" 2>/dev/null || echo false)
    [ "$v" = error ] && { echo "ERROR: stub failure" >&2; exit 1; }
    echo "$v"
    ;;
  "group show")
    cat "$STUB_STATE/group_tags" 2>/dev/null || echo '{}'
    ;;
  "group delete")
    if [ -f "$STUB_STATE/delete_clears" ]; then
      echo false >"$STUB_STATE/group_exists"
      : >"$STUB_STATE/leftovers"
    fi
    exit "$(cat "$STUB_STATE/delete_rc" 2>/dev/null || echo 0)"
    ;;
  "resource list")
    cat "$STUB_STATE/leftovers" 2>/dev/null
    ;;
  *)
    echo "stub az: unexpected call: $*" >&2
    exit 99
    ;;
esac
