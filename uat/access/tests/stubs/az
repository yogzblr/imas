#!/usr/bin/env bash
# Stub az for access_test.sh: bastion tunnels become local listeners, Linux
# run-commands run locally (with stubs first on PATH), Windows run-commands
# return canned output. Behaviour comes from files in $STUB_STATE.
set -u
# log_line <text>: appends one line to calls.log in a single write, under an
# flock when available. Stubs run concurrently (tunnels.sh starts every tunnel
# at once), and a line written in pieces can be glued to another stub's.
log_line() {
  if command -v flock >/dev/null 2>&1; then
    { flock 9; printf '%s\n' "$1" >&9; } 9>>"$STUB_STATE/calls.log"
  else
    printf '%s\n' "$1" >>"$STUB_STATE/calls.log"
  fi
}
line=az
for a in "$@"; do
  line+=" $(printf '%q' "$a")"
done
log_line "$line"

arg() { # arg <flag> <args...>: the value after <flag>
  local f=$1; shift
  while [ $# -gt 0 ]; do
    [ "$1" = "$f" ] && { echo "${2:-}"; return; }
    shift
  done
}

case "$1 $2 $3" in
  "network bastion tunnel")
    # A VM by its resource id, or an address by IP (--target-ip-address).
    id=$(arg --target-resource-id "$@")
    [ -n "$id" ] || id=$(arg --target-ip-address "$@")
    port=$(arg --port "$@")
    rport=$(arg --resource-port "$@")
    if grep -qxF "$id" "$STUB_STATE/fail_ids" 2>/dev/null; then
      echo "ERROR: stub tunnel failure for $id" >&2
      exit 1
    fi
    # fail_once_ids: the first start of these fails, as when another process
    # takes the port first.
    if grep -qxF "$id" "$STUB_STATE/fail_once_ids" 2>/dev/null; then
      mark="$STUB_STATE/failed_once.$(printf '%s' "$id" | md5sum | cut -c1-12)"
      if [ ! -e "$mark" ]; then
        touch "$mark"
        echo "ERROR: [Errno 98] Address already in use (stub)" >&2
        exit 1
      fi
    fi
    # fail_once_keys: the same, for one remote port of a VM ("<id>:<port>").
    if grep -qxF "$id:$rport" "$STUB_STATE/fail_once_keys" 2>/dev/null; then
      mark="$STUB_STATE/failed_once.$(printf '%s' "$id:$rport" | md5sum | cut -c1-12)"
      if [ ! -e "$mark" ]; then
        touch "$mark"
        echo "ERROR: [Errno 98] Address already in use (stub)" >&2
        exit 1
      fi
    fi
    banner=""
    [ "$rport" = 22 ] && [ ! -f "$STUB_STATE/no_banner" ] && banner="SSH-2.0-stub"
    # Like the real az (a shell wrapper around python), the listener is a
    # child process; close must stop both.
    python3 -I -c '
import socket, sys
port, banner = int(sys.argv[1]), sys.argv[2]
s = socket.socket()
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", port))
s.listen(16)
print("Opening tunnel on port: %d" % port, flush=True)
while True:
    c, _ = s.accept()
    try:
        if banner:
            c.sendall((banner + "\r\n").encode())
    except OSError:
        pass
    c.close()
' "$port" "$banner" &
    child=$!
    trap 'kill "$child" 2>/dev/null; exit 0' TERM INT
    wait "$child"
    ;;
esac

case "$1 $2" in
  "vm run-command")
    # expired: fails like an OIDC session past its validity until the
    # relogin stub has run.
    if [ -f "$STUB_STATE/expired" ] && [ ! -f "$STUB_STATE/relogin_done" ]; then
      echo "ERROR: AADSTS700024: Client assertion is not within its valid time range. (stub)" >&2
      exit 1
    fi
    [ -f "$STUB_STATE/runcmd_fail" ] && { echo "ERROR: stub run-command failure" >&2; exit 1; }
    # runcmd_hang: never answers and ignores TERM, so timeout must KILL it.
    if [ -f "$STUB_STATE/runcmd_hang" ]; then
      trap '' TERM
      exec sleep 30
    fi
    # runcmd_conflict: this many calls are refused as while an earlier
    # run-command still runs ("always": every call).
    if [ -f "$STUB_STATE/runcmd_conflict" ]; then
      n=$(cat "$STUB_STATE/runcmd_conflict")
      if [ "$n" = always ] || [ "$n" -gt 0 ]; then
        [ "$n" = always ] || echo $((n - 1)) >"$STUB_STATE/runcmd_conflict"
        echo "ERROR: (Conflict) Run command extension execution is in progress. Please wait for completion before invoking a run command." >&2
        echo "Code: Conflict" >&2
        exit 1
      fi
    fi
    cid=$(arg --command-id "$@")
    # The script lines are everything after --scripts.
    lines=()
    seen=0
    for a in "$@"; do
      if [ "$seen" = 1 ]; then lines+=("$a"); fi
      [ "$a" = "--scripts" ] && seen=1
    done
    script=$(printf '%s\n' "${lines[@]}")
    if [ "$cid" = RunShellScript ]; then
      out=$(bash -c "$script" 2>"$STUB_STATE/stderr.tmp")
      err=$(cat "$STUB_STATE/stderr.tmp")
      [ -f "$STUB_STATE/linux_no_marker" ] && out=$(printf '%s\n' "$out" | grep -v __IMAS_VMCTL_RC__)
      jq -n --arg m "Enable succeeded: "$'\n'"[stdout]"$'\n'"$out"$'\n\n'"[stderr]"$'\n'"$err"$'\n' \
        '{value: [{code: "ProvisioningState/succeeded", level: "Info", message: $m}]}'
    elif [ "$cid" = RunPowerShellScript ]; then
      b64=$(printf '%s\n' "$script" | sed -n "s/.*FromBase64String('\([^']*\)').*/\1/p" | head -n 1)
      log_line "decoded: $(printf '%s' "$b64" | base64 -d)"
      # shellcheck disable=SC2016 # a literal PowerShell line
      if ! printf '%s\n' "$script" | tail -n 1 | grep -qxF 'Write-Output "__IMAS_VMCTL_RC__$__rc"'; then
        echo "stub az: the PowerShell wrapper does not end with the exit code marker" >&2
        exit 98
      fi
      rc=$(cat "$STUB_STATE/win_rc" 2>/dev/null || echo 0)
      out="win-out"$'\r\n'"__IMAS_VMCTL_RC__$rc"$'\r\n'
      [ -f "$STUB_STATE/win_no_marker" ] && out="win-out"$'\r\n'
      jq -n --arg o "$out" --arg e "win-err" \
        '{value: [{code: "ComponentStatus/StdOut/succeeded", message: $o}, {code: "ComponentStatus/StdErr/succeeded", message: $e}]}'
    else
      echo "stub az: unknown command id $cid" >&2
      exit 97
    fi
    ;;
  "vm restart")
    exit "$(cat "$STUB_STATE/restart_rc" 2>/dev/null || echo 0)"
    ;;
  "vm stop")
    # stop_noeffect: Azure accepts the stop but the VM keeps running.
    [ -f "$STUB_STATE/stop_noeffect" ] || echo PowerState/stopped >"$STUB_STATE/power"
    exit "$(cat "$STUB_STATE/stop_rc" 2>/dev/null || echo 0)"
    ;;
  "vm start")
    rm -f "$STUB_STATE/power"
    exit "$(cat "$STUB_STATE/start_rc" 2>/dev/null || echo 0)"
    ;;
  "vm get-instance-view")
    # The guest agent's status and time (agent: "<status> <ISO time>";
    # default Ready, now), or the power state.
    if [[ "$(arg --query "$@")" == *vmAgent* ]]; then
      if [ -f "$STUB_STATE/agent" ]; then
        tr ' ' '\n' <"$STUB_STATE/agent"
      else
        printf 'Ready\n%s\n' "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
      fi
      exit 0
    fi
    cat "$STUB_STATE/power" 2>/dev/null || echo PowerState/running
    ;;
  "network bastion") ;;
  *)
    echo "stub az: unexpected call: $*" >&2
    exit 99
    ;;
esac
