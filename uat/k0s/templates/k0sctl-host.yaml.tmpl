    - role: __ROLE__
__HA_HOST__
      # The hub is reached only through its Azure Bastion tunnels on the
      # runner, so k0sctl dials the node's tunnel address and port from
      # access.json. The system OpenSSH client is used so the host key goes
      # to a per-run known_hosts file under the alias of the VM name
      # (accepted on first use, through the tunnel, then pinned for the run).
      openSSH:
        address: __ACCESS_HOST__
        port: __SSH_PORT__
        user: __ADMIN_USER__
        keyPath: __SSH_KEY__
        options:
          HostKeyAlias: __HOST_ALIAS__
          UserKnownHostsFile: __KNOWN_HOSTS__
          StrictHostKeyChecking: accept-new
          IdentitiesOnly: "yes"
          BatchMode: "yes"
          ServerAliveInterval: "30"
      # The VM's own address in the VNet (not the tunnel's).
      privateAddress: __PRIVATE_IP__
