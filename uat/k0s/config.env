# shellcheck shell=bash
# UAT.2 cluster settings that are not versions: how services are reached
# from outside the hubs, and the UAT CA. Sourced by bootstrap.sh, check.sh
# and expose.sh. README.md explains each choice.

# Services are exposed as NodePort Services whose node port IS the port the
# network rules open (no port translation). Each hub has its own API server
# NodePort range, just wide enough for the ports that hub exposes.
#
# Owner decision, 2026-10-06: Envoy is exposed on node port 8443, and both
# NodePort and LoadBalancer must be supported (production puts Envoy behind
# an application gateway). A DMZ range holding the bus port 5406 and 8443
# also holds the Kubernetes API port 6443. That is an open question for the
# owner (README.md, open question 2): until it is decided, the range below
# keeps the current ports. The node ports that are pinned can never be 6443
# (bootstrap.sh refuses that); only a node port Kubernetes picks by itself
# could land on a reserved port, and check.sh fails on any node port the hub
# does not expose.
UAT_DMZ_NODE_PORT_RANGE=5406-8443
UAT_CORE_NODE_PORT_RANGE=443-5405

# Ports k0s or the node itself listen on. bootstrap.sh refuses to expose any
# of them and warns when a hub's NodePort range contains one: 6443 API
# server, 8080 kube-router metrics, 8132/8133 konnectivity, 9443 k0s API,
# 10249/10250/10256 kube-proxy metrics, kubelet, kube-proxy health.
UAT_RESERVED_NODE_PORTS="6443 8080 8132 8133 9443 10249 10250 10256"

# DMZ hub (deploy/helm/nats). Envoy: the edge sprouts and the runner reach.
# The node port is 8443 (owner decision); the Service port is the chart's
# envoy.service.port (443) and the pod listens on envoy.listenerPort (8443).
UAT_DMZ_ENVOY_PORT=8443
# How the Envoy edge Service is made: NodePort (the UAT default; k0s has no
# load balancer controller) or LoadBalancer (also gets the pinned node port;
# its external address stays pending unless a load balancer controller or an
# application gateway in front provides one). expose.sh --type overrides it.
UAT_DMZ_ENVOY_SERVICE_TYPE=NodePort
# The bus client port core dials (bus.ports.client, farmer's farmerbusurl).
UAT_DMZ_BUS_PORT=5406

# Core hub (deploy/helm/farmer, Keycloak). 443: saasapi and Keycloak behind
# one TLS front (see README.md, open question). farmer.apiPort: what the
# DMZ's Envoy dials for /v1/enroll, /v1/refresh, /files/ and the JWKS.
UAT_CORE_HTTPS_PORT=443
UAT_CORE_FARMER_API_PORT=5405

# Kubernetes API port on each hub (the Bastion kube tunnel's remote port).
UAT_KUBE_API_PORT=6443

# The per-run UAT CA: a cert-manager CA ClusterIssuer of this name on each
# hub, backed by a kubernetes.io/tls Secret of this name in the cert-manager
# namespace. The same root on both hubs.
UAT_CLUSTER_ISSUER=imas-uat-ca
UAT_CA_SECRET=imas-uat-ca
UAT_CERT_MANAGER_NAMESPACE=cert-manager
UAT_CA_DAYS=7
