# shellcheck shell=bash
# Every version UAT.2 installs, pinned in this one file. bootstrap.sh,
# check.sh and install-tools.sh source it. Change a version and its
# checksum together; the scripts refuse a download whose SHA-256 differs.
# Never "latest".

# k0s, installed on both hubs by k0sctl (Apache-2.0). The node downloads the
# binary from the k0s GitHub release itself.
K0S_VERSION=v1.36.4+k0s.1

# k0sctl on the runner (Apache-2.0). bootstrap.sh refuses another version.
K0SCTL_VERSION=v0.33.1
K0SCTL_SHA256_LINUX_AMD64=bd5cd9125c93d8d30c33f7b2f3693fed0d74140a248d433dad74f2b7015295b5
K0SCTL_SHA256_LINUX_ARM64=3632072361f3e83dde9b34f83eea49673d3bfe84763cf361edc3aec7209231a6

# kubectl on the runner (Apache-2.0), the same minor as k0s's Kubernetes.
KUBECTL_VERSION=v1.36.4
KUBECTL_SHA256_LINUX_AMD64=8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a
KUBECTL_SHA256_LINUX_ARM64=0ecf44450ee6063bf19dd166a103ee6df4a9034455c2abce626e6eea657d73fb

# local-path-provisioner (Apache-2.0): the default StorageClass.
LOCAL_PATH_PROVISIONER_VERSION=v0.0.37
LOCAL_PATH_PROVISIONER_URL=https://raw.githubusercontent.com/rancher/local-path-provisioner/v0.0.37/deploy/local-path-storage.yaml
LOCAL_PATH_PROVISIONER_SHA256=9781b39c24f3f651bd6d6e41b561e04e4904bbdb6d4f8c7a6009df3a702dcd65
# The upstream manifest leaves its helper pod's image untagged; bootstrap.sh
# pins it to this one (busybox is GPL-2.0, pulled and run unmodified, UAT
# only; see README.md).
LOCAL_PATH_HELPER_IMAGE=docker.io/library/busybox:1.37.0

# cert-manager (Apache-2.0), the release's static manifest (CRDs included).
CERT_MANAGER_VERSION=v1.21.2
CERT_MANAGER_URL=https://github.com/cert-manager/cert-manager/releases/download/v1.21.2/cert-manager.yaml
CERT_MANAGER_SHA256=e03b668ec8675214af6b0a671699d088f2601fa3878e0dbe1b41d3feafd1879f
