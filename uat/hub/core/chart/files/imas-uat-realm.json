{
  "realm": "imas-uat",
  "displayName": "imas UAT (test only, generated per run)",
  "enabled": true,
  "sslRequired": "external",
  "attributes": {
    "frontendUrl": "${UAT_KEYCLOAK_URL}"
  },
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 30,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "imas-recipes-read",
        "description": "saasapi: GET the tenant recipe routes (saasapi.recipes.readRole)"
      },
      {
        "name": "imas-recipes-write",
        "description": "saasapi: PUT and DELETE the tenant recipe routes (saasapi.recipes.writeRole). A recipe runs as root on the tenant sprouts."
      }
    ]
  },
  "clients": [
    {
      "clientId": "imas-saasapi",
      "name": "imas saasapi (the audience; issues no tokens)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect"
    },
    {
      "clientId": "imas-uat-tests",
      "name": "imas UAT test runner (password grant, UAT only)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${UAT_TESTS_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "saasapi-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "imas-saasapi",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization.id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "t1-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "t1-admin@imas-uat.invalid",
      "firstName": "Tenant 1",
      "lastName": "admin",
      "credentials": [
        {
          "type": "password",
          "value": "${UAT_T1_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "imas-recipes-read",
        "imas-recipes-write",
        "default-roles-imas-uat"
      ]
    },
    {
      "username": "t1-reader",
      "enabled": true,
      "emailVerified": true,
      "email": "t1-reader@imas-uat.invalid",
      "firstName": "Tenant 1",
      "lastName": "reader",
      "credentials": [
        {
          "type": "password",
          "value": "${UAT_T1_READER_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "imas-recipes-read",
        "default-roles-imas-uat"
      ]
    },
    {
      "username": "t2-admin",
      "enabled": true,
      "emailVerified": true,
      "email": "t2-admin@imas-uat.invalid",
      "firstName": "Tenant 2",
      "lastName": "admin",
      "credentials": [
        {
          "type": "password",
          "value": "${UAT_T2_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "imas-recipes-read",
        "imas-recipes-write",
        "default-roles-imas-uat"
      ]
    },
    {
      "username": "t2-reader",
      "enabled": true,
      "emailVerified": true,
      "email": "t2-reader@imas-uat.invalid",
      "firstName": "Tenant 2",
      "lastName": "reader",
      "credentials": [
        {
          "type": "password",
          "value": "${UAT_T2_READER_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "imas-recipes-read",
        "default-roles-imas-uat"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"organization_id\",\"displayName\":\"imas tenant_id (organization.id claim)\",\"validations\":{\"pattern\":{\"pattern\":\"^t_[a-z2-7]{16}$\",\"error-message\":\"must be a saasapi tenant_id\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  }
}
