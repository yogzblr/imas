{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FarmerBuckets",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::RECIPE_BUCKET", "arn:aws:s3:::JOB_BUCKET"]
    },
    {
      "Sid": "FarmerObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::RECIPE_BUCKET/*", "arn:aws:s3:::JOB_BUCKET/*"]
    }
  ]
}
