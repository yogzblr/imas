#!/usr/bin/env bash
# A stand-in for curl (the one in the RustFS image, or the runner's through
# the port-forward to Versity Gateway), for test/object_store_test.sh only:
# answers validate-object-store.sh's signed calls with the status the UAT
# policies (rustfs-setup.sh, or the farmer chart's createBuckets plan) give,
# by access key, method and path, whatever the host and port. The root
# credential is $STUB_S3_ROOT_KEY's. FAKE_S3_BREAK names one deliberate fault: reader-put lets the accounts reader write,
# farmer-accounts lets farmer list the accounts bucket, retention-get lets
# the log retention user read logs, root-delete makes the root credential's
# cleanup DELETEs fail (500).
set -euo pipefail
m=GET user="" url=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	-X) m="$2"; shift 2 ;;
	--user) user="${2%%:*}"; shift 2 ;;
	-o | -w | -H | --data-binary | --aws-sigv4) shift 2 ;;
	-*) shift ;;
	*) url="$1"; shift ;;
	esac
done
printf '%s %s %s\n' "$user" "$m" "$url" >>"${STUB_STATE:?}/s3-curl.log"
p=${url#http://127.0.0.1:*/}
bucket=${p%%[/?]*}
allow=no
case "$user" in
"$STUB_S3_ROOT_KEY")
	allow=yes
	if [[ "${FAKE_S3_BREAK:-}" == root-delete && "$m" == DELETE ]]; then
		printf 500
		exit 0
	fi
	;;
imas-farmer)
	case "$bucket" in imas-recipes | imas-jobs | imas-sprout-jwts) allow=yes ;; esac
	[[ "${FAKE_S3_BREAK:-}" != farmer-accounts || "$bucket" != imas-accounts || "$m" != GET ]] || allow=yes
	;;
imas-saasapi)
	[[ "$bucket" == imas-recipes && ("$p" == imas-recipes/tenants/*/recipes/* || "$p" == *"prefix=tenants/"*"/recipes/"*) ]] && allow=yes
	;;
imas-farmer-accounts) [[ "$bucket" == imas-accounts ]] && allow=yes ;;
imas-bus-accounts-reader)
	[[ "$bucket" == imas-accounts && "$m" == GET ]] && allow=yes
	[[ "${FAKE_S3_BREAK:-}" != reader-put || "$bucket" != imas-accounts ]] || allow=yes
	;;
imas-logs-writer) [[ "$m" == PUT && "$p" == imas-logs/logs/* ]] && allow=yes ;;
imas-logs-retention)
	[[ "$m" == GET && "$p" == "imas-logs?list-type="* ]] && allow=yes
	[[ "$m" == DELETE && "$p" == imas-logs/logs/* ]] && allow=yes
	[[ "${FAKE_S3_BREAK:-}" != retention-get || "$bucket" != imas-logs || "$m" != GET ]] || allow=yes
	;;
esac
if [[ "$allow" == yes ]]; then
	[[ "$m" == DELETE ]] && printf 204 || printf 200
else
	printf 403
fi
