#!/usr/bin/env bash
# A stand-in for curl, for test/finish_test.sh only: the one operator API
# call. It records the URL, --resolve and whether the Authorization header
# (read from its -H @file, never argv) carries FS_TOKEN; copies the request
# body to $FS_STATE/body.json; writes $FS_RESPONSE to -o and prints
# FS_STATUS as -w '%{http_code}' would.
set -euo pipefail
: "${FS_STATE:?}"
out="" url="" resolve="" auth=no
while [[ $# -gt 0 ]]; do
	case "$1" in
	-o) out="$2"; shift 2 ;;
	--resolve) resolve="$2"; shift 2 ;;
	--data-binary) cp "${2#@}" "$FS_STATE/body.json"; shift 2 ;;
	-H)
		if [[ "$2" == @* ]] && grep -qxF "Authorization: Bearer ${FS_TOKEN:?}" "${2#@}"; then auth=yes; fi
		shift 2
		;;
	--proto | --max-time | --cacert | -w) shift 2 ;;
	-*) shift ;;
	*) url="$1"; shift ;;
	esac
done
printf 'curl %s resolve=%s auth=%s\n' "$url" "$resolve" "$auth" >>"$FS_STATE/curl.log"
cp "${FS_RESPONSE:?}" "$out"
printf '%s' "${FS_STATUS:-200}"
