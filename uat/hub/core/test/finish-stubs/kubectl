#!/usr/bin/env bash
# A stand-in for kubectl, for test/finish_test.sh only: the reads and waits
# finish.sh and operator-release.sh make, answered from FS_* variables.
# Every call is appended to $FS_STATE/calls.log.
set -euo pipefail
: "${FS_STATE:?}"
printf 'kubectl %s\n' "$*" >>"$FS_STATE/calls.log"
args=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	--kubeconfig | -n) shift 2 ;;
	*) args+=("$1"); shift ;;
	esac
done
set -- "${args[@]}"
job=imas-core-farmer-sprout-release-register
case "$*" in
"get deployment "*) exit 0 ;;
"patch deployment "*) exit 0 ;;
"rollout status "*) exit "${FS_ROLLOUT_RC:-0}" ;;
# first_start_diagnostics (W7): the core pods, describe, farmer's and saasapi's logs (a
# restarted pod has a previous run), and the DMZ bus pods' tails.
"get pods -o wide") echo "NAME READY STATUS RESTARTS (stub pods)" ;;
"describe "*) echo "Events: (stub describe ${*:2})" ;;
"get pods -l app.kubernetes.io/instance=imas-core,app.kubernetes.io/component=farmer -o name")
	printf 'pod/imas-core-farmer-a\npod/imas-core-farmer-b\n' ;;
"logs pod/imas-core-farmer-a -c farmer --tail=40") echo "farmer-a: announcing 2 reconciled Accounts: no servers available" ;;
"logs pod/imas-core-farmer-b -c farmer --tail=40") echo "farmer-b: current run" ;;
"logs pod/imas-core-farmer-a -c farmer --previous --tail=40") exit 1 ;;
"logs pod/imas-core-farmer-b -c farmer --previous --tail=40") echo "farmer-b: before its restart" ;;
"get pods -l app.kubernetes.io/instance=imas-core,app.kubernetes.io/component=saasapi -o name")
	echo pod/imas-core-farmer-saasapi-a ;;
"logs pod/imas-core-farmer-saasapi-a -c saasapi --tail=40") echo "saasapi-a: nats: no servers available for connection" ;;
"logs pod/imas-core-farmer-saasapi-a -c saasapi --previous --tail=40") echo "saasapi-a: before its restart" ;;
"logs imas-dmz-nats-bus-0 -c farmerbus --tail=40") echo "bus-0 farmerbus: TLS handshake error" ;;
"logs imas-dmz-nats-bus-0 -c loader --tail=40") echo "bus-0 loader: accountloader: initial load complete, 2 accounts" ;;
"get jobs -o name") [[ "${FS_JOB_STATE:-absent}" == absent ]] || echo "job.batch/$job" ;;
"get job $job -o json")
	case "${FS_JOB_STATE:-absent}" in
	absent) echo "Error from server (NotFound): jobs.batch \"$job\" not found" >&2; exit 1 ;;
	failed) echo '{"status":{"failed":2,"conditions":[{"type":"Failed","status":"True","reason":"BackoffLimitExceeded"}]}}' ;;
	running) echo '{"status":{"active":1}}' ;;
	esac
	;;
"wait job/$job --for=condition=complete "*) exit "${FS_WAIT_RC:-0}" ;;
"logs "*) echo "register: POST /v1/operator/fleet-releases: 409 release_conflict" ;;
"get configmap imas-core-farmer-sprout-release -o json")
	[[ -n "${FS_REQUEST:-}" ]] || { echo "Error from server (NotFound)" >&2; exit 1; }
	jq -n --rawfile r "$FS_REQUEST" '{data: {"request.json": $r}}'
	;;
"get secret imas-saasapi-operator-tls -o jsonpath={.data.ca\.crt}")
	printf -- '-----BEGIN CERTIFICATE-----\nZmFrZQ==\n-----END CERTIFICATE-----\n' | base64 -w0
	;;
"port-forward service/imas-core-farmer-saasapi-operator :8443")
	echo "Forwarding from 127.0.0.1:40123 -> 8443"
	exec sleep 60
	;;
*) echo "finish stub kubectl: $* unsupported" >&2; exit 2 ;;
esac
