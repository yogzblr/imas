# shellcheck shell=bash
# Settings of the local rig (UAT.8) that are not versions. Sourced by lib.sh
# after uat/k0s/config.env, which gives the ports, the ClusterIssuer and the
# CA Secret names the Azure hubs use; the rig keeps those unchanged. Every
# value here can be overridden from the environment (README.md, "Settings").
# One rig per machine: the network, the cluster names and the host ports
# below are fixed per machine, not per run.

# run_id as in the Shared contract: 6 to 10 lowercase letters and digits.
: "${LITE_RUN_ID:=lite01}"
# Where the rig keeps its state (kubeconfigs, keys, the UAT CA key, the hub
# scripts' outputs, the test reports). Outside the repository on purpose:
# it holds secrets. up.sh --state overrides it.
: "${LITE_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/imas-uat-lite/$LITE_RUN_ID}"

# The shared Docker network for both clusters and the sprouts. A /24: the
# sprouts get fixed addresses at .21 to .24 (as uat/enroll's sample
# uat-lite.json), Docker gives the kind nodes addresses from the upper half.
: "${LITE_NETWORK:=imas-uat-lite}"
: "${LITE_SUBNET:=172.29.88.0/24}"

# The kind clusters (the brief names them dmz and core). Their node
# containers are <name>-control-plane.
: "${LITE_DMZ_CLUSTER:=dmz}"
: "${LITE_CORE_CLUSTER:=core}"
# Pod and Service ranges, different per cluster so that an address never
# means two things on the one Docker host.
: "${LITE_DMZ_POD_SUBNET:=10.244.0.0/16}"
: "${LITE_DMZ_SERVICE_SUBNET:=10.96.0.0/16}"
: "${LITE_CORE_POD_SUBNET:=10.245.0.0/16}"
: "${LITE_CORE_SERVICE_SUBNET:=10.97.0.0/16}"

# Names. The public FQDNs stand in for <dns label>.<region>.cloudapp.azure.com
# (.test is reserved for testing, RFC 2606); the private names are the
# Shared contract's, dmz.<zone> and core.<zone>, unchanged.
: "${LITE_DOMAIN:=imas-lite.test}"
: "${LITE_PRIVATE_DNS_ZONE:=uat.imas.internal}"

# How the host reaches the hubs' 443 (core) and 8443 (DMZ):
#   direct     the host routes to the Docker network (Docker Engine on
#              Linux); the hub names resolve to the node addresses
#   published  kind publishes those ports on LITE_PUBLISH_ADDRESS and the hub
#              names resolve to it on the host (Docker Desktop, where
#              container addresses are not reachable from the host)
#   auto       published on Docker Desktop, direct otherwise
: "${LITE_HOST_ACCESS:=auto}"
: "${LITE_PUBLISH_ADDRESS:=127.0.0.1}"
# The host's hosts file, where up.sh writes the hub names (with sudo when it
# is not writable). "none" writes nothing and prints the lines instead.
: "${LITE_HOSTS_FILE:=/etc/hosts}"
: "${LITE_SUDO:=sudo}"

# The sprouts: one Ubuntu 24.04 and one AlmaLinux 9 per tenant. The names
# are <t1|t2>-<ubuntu|alma>, the order gives the address (.21 up) and the
# host SSH port (LITE_SSH_PORT_BASE up, on 127.0.0.1).
: "${LITE_SPROUTS:=t1-ubuntu t1-alma t2-ubuntu t2-alma}"
: "${LITE_SSH_PORT_BASE:=22221}"
: "${LITE_CONTAINER_PREFIX:=imas-lite-}"
# The fallback when systemd containers cannot run (README.md, "WSL2"): one
# Ubuntu sprout name from LITE_SPROUTS that is the host itself, reached
# over SSH on 127.0.0.1:LITE_HOST_SPROUT_PORT as LITE_HOST_SPROUT_USER.
: "${LITE_HOST_SPROUT:=}"
: "${LITE_HOST_SPROUT_PORT:=22}"
: "${LITE_HOST_SPROUT_USER:=root}"

# The rig's UAT CA lives longer than an Azure run's (7 days): a local rig
# may stay up for a while. up.sh refuses a CA that expires within a day.
: "${LITE_CA_DAYS:=30}"

# Waits.
: "${LITE_WAIT_TIMEOUT:=600}" # seconds, per rollout, issuer and boot
: "${LITE_POLL_SECONDS:=2}"
