# shellcheck shell=bash
# shellcheck disable=SC2034 # read by lib.sh and the scripts
# Versions the local rig (UAT.8) pins itself. Sourced by lib.sh. The
# cert-manager pin (URL and SHA-256) is UAT.2's, read from
# uat/k0s/versions.env so the rig and the Azure hubs run the same release.
# Never "latest". None of these was pulled by the agent that wrote this
# file (no registry access): the owner confirms them on the first run.

# kind (Apache-2.0, kubernetes-sigs/kind). up.sh warns when the kind on
# PATH is older; kind v0.24 or later enforces NetworkPolicy through kindnet.
LITE_KIND_MIN_VERSION=v0.30.0

# The kind node image (Kubernetes, containerd, runc: Apache-2.0, on a Debian
# base whose packages carry their own licences, GPL among them; pulled and
# run unmodified, UAT only). Pin it to the digest the kind release notes
# list for this tag, e.g. kindest/node:v1.34.0@sha256:<digest>: the agent
# could not read the digest. kubectl on the host must be within one minor
# version of it.
LITE_KIND_NODE_IMAGE=docker.io/kindest/node:v1.34.0

# The sprout base images, Docker Official Images (README.md, "Licences").
LITE_UBUNTU_BASE_IMAGE=docker.io/library/ubuntu:24.04
LITE_ALMA_BASE_IMAGE=docker.io/library/almalinux:9

# The tag of the sprout images up.sh builds from sprouts/*.Dockerfile.
# Bump it when a Dockerfile changes (or pass up.sh --rebuild-images).
LITE_SPROUT_IMAGE_TAG=1
